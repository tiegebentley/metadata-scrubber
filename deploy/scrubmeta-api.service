[Unit]
Description=scrubmeta API (FastAPI backend, served on the tailnet)
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/metadata-scrubber
# The browser uploads straight to this service (no proxy in between), so it
# must be reachable from the same network the UI is served on.
Environment=SCRUBMETA_CORS_ORIGINS=http://100.79.168.65:3000
ExecStart=/usr/local/bin/scrubmeta-web --host 100.79.168.65 --port 8770
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
